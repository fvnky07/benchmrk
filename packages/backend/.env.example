# Convex deployment URLs — run `cd packages/backend && pnpm run dev` once
# to provision a free dev deployment, then copy the URLs it prints here.
CONVEX_DEPLOYMENT=
CONVEX_URL=

# Better Auth
# Generate a new secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth credentials
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <CONVEX_SITE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
