# Convex URLs — match the values printed by `cd packages/backend && pnpm run dev`
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CONVEX_SITE_URL=

# PostHog analytics (optional)
# Set EXPO_PUBLIC_ENABLE_POSTHOG=false to disable PostHog entirely
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional Google iOS URL scheme (required for native Google sign-in on iOS)
GOOGLE_IOS_URL_SCHEME=
