{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", ".expo/**"],
      "env": ["CONVEX_DEPLOY_KEY"]
    },
    "build:ios": {
      "dependsOn": ["^build:ios"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["ios/**", ".expo/**"]
    },
    "build:android": {
      "dependsOn": ["^build:android"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["android/**", ".expo/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "outputs": [],
      "env": ["EXPO_PUBLIC_CONVEX_URL", "EXPO_PUBLIC_CONVEX_SITE_URL"]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "outputs": []
    },
    "android": {
      "cache": false,
      "persistent": true,
      "outputs": []
    },
    "ios": {
      "cache": false,
      "persistent": true,
      "outputs": []
    },
    "web": {
      "cache": false,
      "persistent": true,
      "outputs": []
    }
  }
}
