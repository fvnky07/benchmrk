{
  "name": "benchmrk",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:web": "turbo run build --filter=website",
    "build:ios": "turbo run build:ios --filter=@native/app",
    "build:android": "turbo run build:android --filter=@native/app",
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=website",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check-types": "turbo run check-types",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "husky": "^9.1.7",
    "turbo": "^2.7.5",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "esbuild",
      "protobufjs",
      "sharp"
    ]
  }
}
