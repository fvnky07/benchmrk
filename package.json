{
  "name": "benchmrk",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:all": "turbo run build --filter='./apps/*' --filter='./packages/backend'",
    "build:web": "turbo run build --filter=website",
    "build:mobile": "turbo run build --filter=@mobile/app",
    "build:ios": "turbo run ios --filter=@mobile/app",
    "build:android": "turbo run android --filter=@mobile/app",
    "build:web-ios-android": "pnpm run build:web && pnpm run build:ios & pnpm run build:android &",
    "dev": "turbo run dev --parallel",
    "dev:all": "turbo run dev --parallel --filter='./apps/*' --filter='./packages/backend'",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.8.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.7.5",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "eslint": "^9.39.2"
  }
}
