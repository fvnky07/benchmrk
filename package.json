{
  "name": "benchmrk",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:web": "turbo run build --filter=website",
    "build:ios": "turbo run build:ios --filter=@native/app",
    "build:android": "turbo run build:android --filter=@native/app",
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=website",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.7.5",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=18"
  },
  "lint-staged": {
    "**/*.{ts,tsx,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "eslint": "^9.39.2"
  }
}
